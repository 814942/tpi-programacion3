# ============================================
# Food Store Backend — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores.
# Spring Boot NO lee .env automáticamente — usar una de las
# opciones en "Cómo setear las variables" más abajo.
# ============================================

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/foodstore
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
JWT_SECRET=clave-secreta-para-jwt-debe-tener-al-menos-256-bits-de-longitud-para-hs256
JWT_EXPIRATION=86400000

# --- Servidor ---
SERVER_PORT=8080

# ============================================
# Cómo setear las variables
# ============================================
#
# Linux / Git Bash:
#   export DB_PASSWORD=miPassword123
#   ./gradlew bootRun
#
# Windows (PowerShell):
#   $env:DB_PASSWORD="miPassword123"
#   .\gradlew.bat bootRun
#
# Windows (CMD):
#   set DB_PASSWORD=miPassword123
#   .\gradlew.bat bootRun
#
# Con IntelliJ / VS Code: configurar en "Run Configurations" → Environment Variables
# ============================================
